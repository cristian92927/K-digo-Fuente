# Base de datos PostgreSQL
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=promociones

# Usada por el backend (construida automáticamente en docker-compose)
DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/promociones

# Puerto del backend (opcional, default 3000)
PORT=3000
